# RecommendMe API environment template
# Copy to .env in repository root or Environment/.env for local development.

APP_ENV=development
DEBUG=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

GROQ_API_KEY=
GROQ_MODEL=gpt-oss-120B

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi3

SERPAPI_KEY=

REDIS_URL=redis://localhost:6379

SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$

RATE_LIMIT_PER_MINUTE=10
SESSION_TTL_MINUTES=30

AFFILIATE_TAG=
