# =============================================================================
# RecommendMe API — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in the values below.
# All variables are loaded by pydantic-settings (app/core/config.py)
#
# IMPORTANT: .env should NOT be committed to version control
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED FOR PRODUCTION (API Keys)
# ─────────────────────────────────────────────────────────────────────────────

# OpenAI API Key (for GPT-4o model)
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Google Gemini API Key (for gemini-2.0-flash model)
# Get it from: https://aistudio.google.com/apikey
GEMINI_API_KEY=...

# Groq API Key (for llama-3.3-70b-versatile model)
# Get it from: https://console.groq.com/keys
GROQ_API_KEY=...

# SerpAPI Key (for Google Shopping search)
# Get it from: https://serpapi.com/manage/api_key
SERPAPI_KEY=...

# ─────────────────────────────────────────────────────────────────────────────
# INFRASTRUCTURE
# ─────────────────────────────────────────────────────────────────────────────

# Redis URL (for caching, sessions, and rate limiting)
# Local development: redis://localhost:6379
# Railway production: Railway auto-provides this when Redis service is added
# Format: redis://[:password]@host:port/database
REDIS_URL=redis://localhost:6379

# ─────────────────────────────────────────────────────────────────────────────
# CORS (Cross-Origin Resource Sharing)
# ─────────────────────────────────────────────────────────────────────────────

# Local development (default)
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# Production (update with your Vercel frontend URL)
# Example: CORS_ORIGINS=["https://recommendme-app.vercel.app"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]

# Optional: Use regex pattern instead of list (for dynamic subdomains)
# CORS_ORIGIN_REGEX=

# ─────────────────────────────────────────────────────────────────────────────
# APPLICATION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Environment: development | staging | production
APP_ENV=development

# Debug mode (set to False in production)
DEBUG=True

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# Session TTL (time-to-live in minutes)
SESSION_TTL_MINUTES=30

# Affiliate tag (if using Amazon affiliate links, leave blank if not needed)
# AFFILIATE_TAG=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Local Model (Ollama)
# ─────────────────────────────────────────────────────────────────────────────

# Ollama server URL (for local/private model inference)
# Default: http://localhost:11434
# Only needed if you want to use local models as fallback
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=phi3

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Additional AI Providers
# ─────────────────────────────────────────────────────────────────────────────

# Grok API Key (X.AI) - optional
# GROK_API_KEY=

# Other AI provider key - optional
# OTHER_API_KEY=

# =============================================================================
# RAILWAY DEPLOYMENT NOTES
# =============================================================================
# 1. Create a new Railway project
# 2. Add Redis service (Railway Marketplace → Redis)
# 3. Set these environment variables in Railway dashboard:
#    - OPENAI_API_KEY
#    - GEMINI_API_KEY
#    - GROQ_API_KEY
#    - SERPAPI_KEY
#    - CORS_ORIGINS (with your Vercel frontend URL after deploying frontend)
#    - APP_ENV=production
#    - DEBUG=False
#    - RATE_LIMIT_PER_MINUTE=10 (adjust based on traffic)
# 4. Railway auto-provides REDIS_URL when Redis service is linked
# 5. Deploy will use the Dockerfile and railway.toml configuration
# =============================================================================
