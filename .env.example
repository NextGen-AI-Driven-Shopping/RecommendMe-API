# =============================================================================
# RecommendMe API — Environment Configuration
# =============================================================================
# Fill in the values below and keep this file out of version control.
# All variables are loaded by pydantic-settings (app/config/settings.py).
# =============================================================================


# -----------------------------------------------------------------------------
# Application metadata
# -----------------------------------------------------------------------------

# Human-readable name used in logs and the OpenAPI docs title.
APP_NAME=RecommendMe API

# Runtime environment: development | staging | production
APP_ENV=development

# Enable FastAPI debug mode (exposes Python tracebacks in error responses).
# Set to False before deploying to staging or production.
DEBUG=False


# -----------------------------------------------------------------------------
# AI service — OpenAI
# -----------------------------------------------------------------------------

# API key for OpenAI.  Used by:
#   - Tier 2 intent extraction  (GPT-4o)
#   - Product ranking / explanation generation  (GPT-4o)
#   - Vagueness detection fallback  (GPT-4o-mini)
# Obtain a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=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
OPENAI_MODELS=["gpt-4.1", "gpt-4o", "gpt-4.1-mini"]


# -----------------------------------------------------------------------------
# AI service — Ollama (local LLM)
# -----------------------------------------------------------------------------

# Base URL of the Ollama REST API (no trailing slash).
# When running Ollama inside Docker Compose, change to http://ollama:11434.
OLLAMA_URL=http://localhost:11434

# Ollama model used for Tier 1 vagueness classification.
# Run `ollama pull phi3` to download this model locally.
OLLAMA_MODEL=phi3
OLLAMA_MODELS=["phi3", "phi3:latest", "llama3.2"]


# -----------------------------------------------------------------------------
# External APIs — SerpAPI
# -----------------------------------------------------------------------------

# API key for SerpAPI Google Shopping search.
# Powers the product fetch service (app/services/products.py).
# Obtain a key at: https://serpapi.com/manage-api-key
SERPAPI_KEY=


# -----------------------------------------------------------------------------
# Infrastructure — Redis
# -----------------------------------------------------------------------------

# Redis connection URL for the optional caching layer.
# Results are cached to reduce redundant AI calls and SerpAPI quota usage.
# Format: redis://[password@]host:port[/db]
REDIS_URL=redis://localhost:6379


# -----------------------------------------------------------------------------
# Supabase — Authentication
# -----------------------------------------------------------------------------

# Your Supabase project URL (found in Project Settings > API).
SUPABASE_URL=

# JWT secret from Supabase Project Settings > API > JWT Settings.
# Used to verify HS256-signed Supabase tokens.
SUPABASE_JWT_SECRET=

# JWKS URL for RS256 verification (recommended for production).
# Auto-derived from SUPABASE_URL if left blank:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=


# -----------------------------------------------------------------------------
# Security — CORS
# -----------------------------------------------------------------------------

# Comma-separated list of allowed frontend origins.
# Must be formatted as a JSON array because pydantic-settings parses List[str]
# fields as JSON.  Example for multiple origins:
#   CORS_ORIGINS=["http://localhost:3000","https://app.yourdomain.com"]
# IMPORTANT: Frontend runs on 5173 (Vite), not 3000!
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8080","https://recommendme-app-production-ui.up.railway.app"]


# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------

# Maximum number of API requests allowed per IP address per minute.
RATE_LIMIT_PER_MINUTE=10


# -----------------------------------------------------------------------------
# Sessions
# -----------------------------------------------------------------------------

# Idle session TTL in minutes.  Inactive sessions are evicted after this period.
# In multi-worker deployments this value also controls the Redis key TTL.
SESSION_TTL_MINUTES=30


# -----------------------------------------------------------------------------
# AI service — Additional providers
# -----------------------------------------------------------------------------

# API key for Google Gemini (or other Gemini-compatible API). Obtain from
# the provider dashboard and paste the key below.
GEMINI_API_KEY=
GEMINI_MODELS=["gemini-2.0-flash", "gemini-1.5-pro", "gemini-1.5-flash"]

# API key for GROQ (e.g., Sanity/GROQ-powered search). Obtain from your
# GROQ provider and paste the key below.
GROQ_API_KEY=
GROQ_MODELS=["llama-3.3-70b-versatile", "gpt-oss-120b", "qwen/qwen3-32b"]

# GROK provider and paste the key below.
GROK_API_KEY=
GROK_MODELS=["grok-1.0-pro", "grok-1.0-flash"]





